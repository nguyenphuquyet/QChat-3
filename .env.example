DATABASE_URL=postgresql://qchat:CHANGE_ME@postgres:5432/qchat
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_ORIGIN=https://chat.example.com
S3_ENDPOINT=https://files.example.com
S3_REGION=us-east-1
S3_BUCKET=qchat-private
S3_ACCESS_KEY=qchat
S3_SECRET_KEY=CHANGE_ME_LONG_RANDOM
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QChat <noreply@example.com>
REALTIME_PORT=3001
# Mini Apps: builds use the private S3 bucket when configured. The filesystem
# fallback needs a persistent directory; set an independent signing secret.
MINIAPP_STORAGE_DIR=/var/lib/qchat/miniapps
MINIAPP_SIGNING_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
# Push notifications (FCM). The service account key is NOT in the repository:
# GitHub push protection rejects Google Cloud credentials. On the server put it
# at apps/server/secrets/firebase-service-account.json (git-ignored), or set one
# of the variables below: paste the JSON into FIREBASE_SERVICE_ACCOUNT or point
# FIREBASE_SERVICE_ACCOUNT_FILE at the file (Firebase console -> Project
# settings -> Service accounts). With no key anywhere, the server sends no push
# and everything else keeps working.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
