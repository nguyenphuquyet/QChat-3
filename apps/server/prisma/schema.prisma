generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  qchatId String @unique
  email String @unique
  passwordHash String
  nickname String
  bio String @default("")
  gender String @default("")
  region String @default("")
  phone String @default("")
  poke String @default("")
  avatarId String? @db.Uuid
  emailVerified Boolean @default(false)
  disabled Boolean @default(false)
  role String @default("USER")
  adminPermissions String[] @default([])
  allowRequests Boolean @default(true)
  previewPush Boolean @default(false)
  createdAt DateTime @default(now())
  sessions UserSession[]
  members ConversationMember[]
  messages Message[]
  requestsSent FriendRequest[] @relation("requestSender")
  requestsReceived FriendRequest[] @relation("requestRecipient")
  friendships Friendship[] @relation("friendOwner")
  friendsOf Friendship[] @relation("friendTarget")
  blocks BlockedUser[] @relation("blockOwner")
  blockedBy BlockedUser[] @relation("blockTarget")
  moments Moment[]
  momentComments MomentComment[]
  media Media[]
  tokens AccountToken[]
  devices PushDevice[]
  feedback Feedback[]
  wallet Wallet?
  miniApps MiniApp[] @relation("miniAppOwner")
  miniAppMemberships MiniAppMember[]
  miniAppRecents UserRecentMiniApp[]
  miniAppFavorites UserFavoriteMiniApp[]
}
model UserSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  refreshHash String @unique
  previousHash String? @unique
  deviceName String
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,revokedAt])
}
model AccountToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  hash String @unique
  kind String
  expiresAt DateTime
}
model FriendRequest {
  id String @id @default(uuid()) @db.Uuid
  senderId String @db.Uuid
  recipientId String @db.Uuid
  sender User @relation("requestSender",fields:[senderId],references:[id],onDelete:Cascade)
  recipient User @relation("requestRecipient",fields:[recipientId],references:[id],onDelete:Cascade)
  status String @default("PENDING")
  createdAt DateTime @default(now())
  @@unique([senderId,recipientId])
  @@index([recipientId,status])
}
model Friendship {
  ownerId String @db.Uuid
  friendId String @db.Uuid
  owner User @relation("friendOwner",fields:[ownerId],references:[id],onDelete:Cascade)
  friend User @relation("friendTarget",fields:[friendId],references:[id],onDelete:Cascade)
  remark String @default("")
  @@id([ownerId,friendId])
}
model BlockedUser {
  ownerId String @db.Uuid
  targetId String @db.Uuid
  owner User @relation("blockOwner",fields:[ownerId],references:[id],onDelete:Cascade)
  target User @relation("blockTarget",fields:[targetId],references:[id],onDelete:Cascade)
  @@id([ownerId,targetId])
}
model Conversation {
  id String @id @default(uuid()) @db.Uuid
  kind String
  directKey String? @unique
  title String @default("")
  announcement String @default("")
  wallpaperColor String?
  wallpaperMediaId String? @db.Uuid
  wallpaperMedia Media? @relation("ConversationWallpaper", fields:[wallpaperMediaId], references:[id], onDelete:SetNull)
  sequence Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ConversationMember[]
  messages Message[]
  calls CallSession[]
  @@index([wallpaperMediaId])
}
model ConversationMember {
  conversationId String @db.Uuid
  userId String @db.Uuid
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role String @default("MEMBER")
  muted Boolean @default(false)
  pinned Boolean @default(false)
  hidden Boolean @default(false)
  readSequence Int @default(0)
  markedUnread Boolean @default(false)
  clearedSequence Int @default(0)
  deliveredSequence Int @default(0)
  @@id([conversationId,userId])
  @@index([userId,pinned])
}
model Message {
  id String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  senderId String @db.Uuid
  sender User @relation(fields:[senderId],references:[id])
  clientId String @db.Uuid
  sequence Int
  kind String @default("TEXT")
  text String @default("")
  replyToId String? @db.Uuid
  replyTo Message? @relation("Replies",fields:[replyToId],references:[id],onDelete:SetNull)
  replies Message[] @relation("Replies")
  mediaId String? @db.Uuid
  media Media? @relation(fields:[mediaId],references:[id])
  recalledAt DateTime?
  createdAt DateTime @default(now())
  states MessageUserState[]
  moneyTransfer MoneyTransfer?
  @@unique([senderId,clientId])
  @@unique([conversationId,sequence])
}
model MoneyTransfer {
  id String @id @default(uuid()) @db.Uuid
  messageId String? @unique @db.Uuid
  message Message? @relation(fields:[messageId],references:[id],onDelete:SetNull)
  senderId String @db.Uuid
  recipientId String? @db.Uuid
  amount Int
  kind String
  note String @default("")
  status String @default("PENDING")
  claimedAt DateTime?
  refundedAt DateTime?
  recipientCount Int @default(1)
  claimedCount Int @default(0)
  createdAt DateTime @default(now())
  claims MoneyTransferClaim[]
  @@index([recipientId,status])
  @@index([senderId,createdAt])
  @@index([status,createdAt])
}
model MoneyTransferClaim {
  transferId String @db.Uuid
  userId String @db.Uuid
  transfer MoneyTransfer @relation(fields:[transferId],references:[id],onDelete:Cascade)
  amount Int
  status String @default("PENDING")
  claimedAt DateTime?
  @@id([transferId,userId])
  @@index([userId,status])
}
model MessageUserState {
  messageId String @db.Uuid
  userId String @db.Uuid
  message Message @relation(fields:[messageId],references:[id],onDelete:Cascade)
  hidden Boolean @default(false)
  favorite Boolean @default(false)
  @@id([messageId,userId])
}
model Media {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner User @relation(fields:[ownerId],references:[id])
  key String @unique
  mime String
  size Int
  name String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  messages Message[]
  moments MomentMedia[]
  wallpapers Conversation[] @relation("ConversationWallpaper")
}
model Moment {
  id String @id @default(uuid()) @db.Uuid
  authorId String @db.Uuid
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  text String
  privacy String @default("FRIENDS")
  createdAt DateTime @default(now())
  media MomentMedia[]
  likes MomentLike[]
  comments MomentComment[]
  @@index([authorId,createdAt])
}
model MomentMedia {
  momentId String @db.Uuid
  mediaId String @db.Uuid
  moment Moment @relation(fields:[momentId],references:[id],onDelete:Cascade)
  media Media @relation(fields:[mediaId],references:[id])
  @@id([momentId,mediaId])
}
model MomentLike {
  momentId String @db.Uuid
  userId String @db.Uuid
  moment Moment @relation(fields:[momentId],references:[id],onDelete:Cascade)
  @@id([momentId,userId])
}
model MomentComment {
  id String @id @default(uuid()) @db.Uuid
  momentId String @db.Uuid
  userId String @db.Uuid
  moment Moment @relation(fields:[momentId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  text String
  createdAt DateTime @default(now())
  @@index([momentId,createdAt])
}
model PushDevice {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  token String @unique
  platform String
}
model CallSession {
  id String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  callerId String @db.Uuid
  calleeId String @db.Uuid
  kind String
  status String @default("RINGING")
  createdAt DateTime @default(now())
  endedAt DateTime?
}
model Wallet {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  balance Int @default(0)
  bonusGranted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions WalletTransaction[]
}
model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid
  wallet Wallet @relation(fields:[walletId],references:[userId],onDelete:Cascade)
  amount Int
  kind String @default("TRANSFER")
  note String @default("")
  peerId String? @db.Uuid
  peerName String @default("")
  createdAt DateTime @default(now())
  @@index([walletId,createdAt])
}
model Report {
  id String @id @default(uuid()) @db.Uuid
  reporterId String @db.Uuid
  targetId String @db.Uuid
  reason String
  status String @default("OPEN")
  createdAt DateTime @default(now())
}
model Feedback {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  content String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  handledAt DateTime?
  @@index([status,createdAt])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  action String
  targetId String
  createdAt DateTime @default(now())
}
model SiteLink {
  id String @id @default(uuid()) @db.Uuid
  platform String @unique
  label String
  url String @default("")
  note String @default("")
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
}
/// Payment services shown on the mobile payments screen. The admin console
/// stores overrides for the built-in catalogue so labels, grouping and
/// availability can change without a mobile release.
model PaymentService {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  label String
  group String @default("Dịch vụ hàng ngày")
  note String @default("")
  enabled Boolean @default(true)
  sortOrder Int @default(0)
  updatedAt DateTime @updatedAt
}
model Outbox {
  id String @id @default(uuid()) @db.Uuid
  event String
  room String
  payload Json
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  @@index([deliveredAt,createdAt])
}

model MiniApp {
  id String @id @default(uuid()) @db.Uuid
  appId String @unique
  name String
  description String @default("")
  iconUrl String @default("")
  category String @default("utilities")
  developerName String @default("")
  supportUrl String @default("")
  privacyUrl String @default("")
  contactEmail String @default("")
  status String @default("DRAFT")
  currentVersion String?
  requestedPermissions String[] @default([])
  developerId String @db.Uuid
  developer User @relation("miniAppOwner", fields:[developerId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions MiniAppVersion[]
  members MiniAppMember[]
  releases MiniAppRelease[]
  permissionRequests MiniAppPermissionRequest[]
  apiKeys MiniAppApiKey[]
  recents UserRecentMiniApp[]
  favorites UserFavoriteMiniApp[]
  analytics MiniAppAnalyticsEvent[]
  @@index([status,updatedAt])
  @@index([category,status])
  @@index([developerId,updatedAt])
}

model MiniAppVersion {
  id String @id @default(uuid()) @db.Uuid
  miniAppId String @db.Uuid
  miniApp MiniApp @relation(fields:[miniAppId],references:[id],onDelete:Cascade)
  version String
  storageKey String
  sha256 String
  size Int
  manifest Json
  entry String
  minRuntimeVersion String @default("1.0.0")
  requestedPermissions String[] @default([])
  status String @default("UPLOADED")
  channel String @default("DEVELOPMENT")
  uploadedBy String @db.Uuid
  createdAt DateTime @default(now())
  publishedAt DateTime?
  revokedAt DateTime?
  revokeReason String @default("")
  reviews MiniAppReview[]
  releases MiniAppRelease[]
  @@unique([miniAppId,version])
  @@index([miniAppId,createdAt])
  @@index([status])
}

model MiniAppReview {
  id String @id @default(uuid()) @db.Uuid
  versionId String @db.Uuid
  version MiniAppVersion @relation(fields:[versionId],references:[id],onDelete:Cascade)
  reviewerId String @db.Uuid
  decision String
  reason String @default("")
  createdAt DateTime @default(now())
  @@index([versionId,createdAt])
}

model MiniAppRelease {
  id String @id @default(uuid()) @db.Uuid
  miniAppId String @db.Uuid
  miniApp MiniApp @relation(fields:[miniAppId],references:[id],onDelete:Cascade)
  versionId String @db.Uuid
  version MiniAppVersion @relation(fields:[versionId],references:[id],onDelete:Cascade)
  versionLabel String
  action String
  actorId String @db.Uuid
  note String @default("")
  createdAt DateTime @default(now())
  @@index([miniAppId,createdAt])
}

model MiniAppPermissionRequest {
  id String @id @default(uuid()) @db.Uuid
  miniAppId String @db.Uuid
  miniApp MiniApp @relation(fields:[miniAppId],references:[id],onDelete:Cascade)
  permission String
  reason String
  status String @default("PENDING")
  requestedBy String @db.Uuid
  reviewedBy String? @db.Uuid
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([miniAppId,createdAt])
  @@index([status,createdAt])
}

model MiniAppMember {
  id String @id @default(uuid()) @db.Uuid
  miniAppId String @db.Uuid
  miniApp MiniApp @relation(fields:[miniAppId],references:[id],onDelete:Cascade)
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role String @default("DEVELOPER")
  createdAt DateTime @default(now())
  @@unique([miniAppId,userId])
}

model MiniAppApiKey {
  id String @id @default(uuid()) @db.Uuid
  miniAppId String @db.Uuid
  miniApp MiniApp @relation(fields:[miniAppId],references:[id],onDelete:Cascade)
  name String
  prefix String @unique
  secretHash String
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
  @@index([miniAppId])
}

model UserRecentMiniApp {
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  miniAppId String @db.Uuid
  miniApp MiniApp @relation(fields:[miniAppId],references:[id],onDelete:Cascade)
  openedAt DateTime @default(now())
  openCount Int @default(1)
  @@id([userId,miniAppId])
  @@index([userId,openedAt])
}

model UserFavoriteMiniApp {
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  miniAppId String @db.Uuid
  miniApp MiniApp @relation(fields:[miniAppId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@id([userId,miniAppId])
}

model MiniAppAnalyticsEvent {
  id String @id @default(uuid()) @db.Uuid
  miniAppId String @db.Uuid
  miniApp MiniApp @relation(fields:[miniAppId],references:[id],onDelete:Cascade)
  version String @default("")
  event String
  userId String? @db.Uuid
  errorCode String @default("")
  durationMs Int @default(0)
  createdAt DateTime @default(now())
  @@index([miniAppId,createdAt])
  @@index([event,createdAt])
}
