{
  "name": "@qchat/miniapp-ide",
  "private": true,
  "version": "1.0.0",
  "description": "QChat Mini App Studio — a desktop IDE for building TSX mini apps",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
