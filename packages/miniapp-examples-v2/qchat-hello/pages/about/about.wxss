.page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.detail {
  font-size: 32rpx;
  color: #555555;
}

.back {
  width: 100%;
}

[data-theme="dark"] .page {
  background: #111827;
  color: #f9fafb;
}

[data-theme="dark"] .detail {
  color: #d1d5db;
}
