<div class="qchat-progress"><div class="qchat-progress__bar" style="height: {{strokeWidth}}px; background-color: {{backgroundColor}}; border-radius: {{borderRadius}}px"><div class="qchat-progress__fill {{active ? 'qchat-progress__fill--active qchat-progress__fill--' + activeMode : ''}}" style="width: {{percent}}%; background-color: {{activeColor}}; border-radius: {{borderRadius}}px"></div></div><span wx:if="{{showInfo}}" class="qchat-progress__info" style="font-size: {{fontSize}}px">{{percent}}%</span></div>
