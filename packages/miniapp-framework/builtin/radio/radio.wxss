.qchat-radio {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
  cursor: pointer;
}

.qchat-radio__box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 22px;
  height: 22px;
  margin-right: 5px;
  background-color: #ffffff;
  border: 1px solid #d1d1d1;
  border-radius: 50%;
  transition: border-color 0.15s;
}

.qchat-radio__dot {
  display: block;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  transform: scale(0);
  transition: transform 0.15s;
}

.qchat-radio--on .qchat-radio__dot {
  transform: scale(1);
}

.qchat-radio--disabled {
  opacity: 0.4;
}

.qchat-radio__label {
  display: inline-block;
}
