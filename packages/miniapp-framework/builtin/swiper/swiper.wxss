/*
 * The host is the viewport. The track is a flex row (or column) that slides by
 * one item size per index; `swiper-item` supplies the item size through the
 * `--qchat-swiper-item-size` custom property the component sets inline.
 */
.qchat-swiper {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.qchat-swiper__track {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 100%;
  transition-property: transform;
  transition-timing-function: ease;
  will-change: transform;
}

.qchat-swiper__dots {
  position: absolute;
  bottom: 10px;
  left: 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
  width: 100%;
  pointer-events: none;
}

.qchat-swiper__dots--vertical {
  top: 0;
  right: 10px;
  bottom: auto;
  left: auto;
  flex-direction: column;
  width: auto;
  height: 100%;
  align-items: center;
}

.qchat-swiper__dot {
  display: block;
  width: 8px;
  height: 8px;
  margin: 0 4px;
  border-radius: 4px;
  pointer-events: auto;
}

.qchat-swiper__dot--active {
  width: 16px;
}
