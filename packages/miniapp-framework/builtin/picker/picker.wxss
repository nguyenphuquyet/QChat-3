/*
 * `selector`, `time` and `date` use a real native control stretched over the
 * host with zero opacity, so a tap anywhere on the picker opens the platform's
 * own chooser. `multiSelector` shows one native column per range entry.
 */
.qchat-picker {
  position: relative;
  display: inline-block;
  box-sizing: border-box;
  min-width: 60px;
  min-height: 1.4rem;
  vertical-align: middle;
}

.qchat-picker__text {
  display: inline-block;
  line-height: 1.4;
}

.qchat-picker__overlay {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
  cursor: pointer;
}

.qchat-picker__columns {
  display: flex;
  flex-direction: row;
  gap: 8px;
  width: 100%;
}

.qchat-picker__column {
  flex: 1 1 0;
  min-width: 0;
  font-size: inherit;
}

.qchat-picker__confirm {
  display: inline-block;
  margin-left: 8px;
  padding: 2px 10px;
  color: #ffffff;
  font-size: 13px;
  line-height: 1.6;
  background-color: #07c160;
  border-radius: 4px;
  cursor: pointer;
}

.qchat-picker__unsupported {
  display: inline-block;
  color: #fa5151;
  font-size: 13px;
}

.qchat-picker--disabled {
  opacity: 0.4;
}
