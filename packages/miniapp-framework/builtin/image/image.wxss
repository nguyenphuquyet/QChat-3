.qchat-image__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: fill;
}

.qchat-image__img--aspectFit {
  object-fit: contain;
}

.qchat-image__img--aspectFill {
  object-fit: cover;
}

.qchat-image__img--widthFix {
  width: 100%;
  height: auto;
  object-fit: contain;
}

.qchat-image__img--heightFix {
  width: auto;
  height: 100%;
  object-fit: contain;
}

.qchat-image__img--empty {
  visibility: hidden;
}
