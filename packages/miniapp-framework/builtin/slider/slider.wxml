<div class="qchat-slider {{disabled ? 'qchat-slider--disabled' : ''}}"><div class="qchat-slider__track" style="background-color: {{backgroundColor}}"><div class="qchat-slider__fill" style="width: {{percent}}%; background-color: {{selectedColor || activeColor}}"></div><div class="qchat-slider__thumb" style="left: {{percent}}%; width: {{blockSize}}px; height: {{blockSize}}px; background-color: {{blockColor}}"></div><div wx:if="{{showValue}}" class="qchat-slider__value" style="left: {{percent}}%">{{value}}</div></div></div>
