{
  "name": "@mna/qchat",
  "version": "3.0.0",
  "description": "QChat Mini Program builder: official glass-easel Webpack pipeline and .japp packager",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qchat": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js"
    },
    "./wechat": {
      "types": "./dist/wechat.d.ts",
      "import": "./dist/wechat.js"
    },
    "./zip": {
      "types": "./dist/zip.d.ts",
      "import": "./dist/zip.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "builtin",
    "runtime",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.10.1",
    "jsdom": "^26.1.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "css-loader": "6.11.0",
    "glass-easel": "^1.2.2",
    "glass-easel-miniprogram-adapter": "^1.2.2",
    "glass-easel-miniprogram-webpack-plugin": "1.2.2",
    "glass-easel-stylesheet-compiler": "^1.2.2",
    "glass-easel-template-compiler": "^1.2.2",
    "mini-css-extract-plugin": "2.9.2",
    "webpack": "5.101.3"
  }
}
